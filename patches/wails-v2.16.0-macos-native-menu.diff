+// --- Tacivan 补丁：角色菜单的文案跟随语言 ---
+// Wails 把「Edit / Window / About …」写死成英文，导致中文界面下菜单栏一半中文一半英文。
+// 这里按当前首选语言查一张小表；语言来自 NSLocale，会尊重
+// `defaults write <bundle id> AppleLanguages` 这个按应用的覆盖，Go 那边切语言时会写它。
+static NSString* TacivanL(NSString* key) {
+    static NSDictionary* zh = nil;
+    static BOOL isZh = NO;
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{
+        NSString* lang = [[NSLocale preferredLanguages] firstObject] ?: @"en";
+        isZh = [lang hasPrefix:@"zh"];
+        zh = @{
+            @"Edit": @"编辑", @"Undo": @"撤销", @"Redo": @"重做", @"Cut": @"剪切", @"Copy": @"拷贝",
+            @"Paste": @"粘贴", @"Paste and Match Style": @"粘贴并匹配样式", @"Delete": @"删除",
+            @"Select All": @"全选", @"Speech": @"语音", @"Start Speaking": @"开始朗读", @"Stop Speaking": @"停止朗读",
+            @"Window": @"窗口", @"Minimize": @"最小化", @"Zoom": @"缩放", @"Full Screen": @"进入全屏幕",
+            @"Hide Others": @"隐藏其他", @"Show All": @"全部显示",
+            @"About ": @"关于 ", @"Hide ": @"隐藏 ", @"Quit ": @"退出 ", @"Settings…": @"设置…",
+        };
+    });
+    if (!isZh) return key;
+    NSString* v = zh[key];
+    return v ? v : key;
+}
